{
  "name": "rechnungsprogramm",
  "version": "1.0.5",
  "description": "W-Link ERP Rechnungsprogramm - Professionelle Desktop-Anwendung",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder",
    "package": "electron-packager . \"W-Link ERP\" --platform=win32 --arch=x64 --icon=dist/.icon-ico/icon.ico --overwrite --out=out --prune",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.wlink.erp",
    "productName": "W-Link ERP",
    "artifactName": "W-Link-Setup.exe",
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "W-Link ERP"
    },
    "files": [
      "**/*",
      "!.git/*",
      "!tests/*",
      "!benchmark_*",
      "!remotion-video/*",
      "!App version/*",
      "!.gemini/*",
      "!.agents/*",
      "!.specify/*",
      "!aistudio api/*",
      "!aistudio_api_backup/*",
      "!scren_backup/*",
      "!*.md",
      "!*.txt",
      "!A_modern*.png",
      "!screen.png",
      "!verify_*.py",
      "!test_*.js",
      "!benchmark_*.js",
      "!start.bat"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ]
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^32.3.3",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "prebuild-install": "^7.1.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "qrcode": "^1.5.4"
  }
}
