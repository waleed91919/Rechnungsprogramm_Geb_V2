<?xml version="1.0" encoding="UTF-8"?>
<!-- GAEB DA XML 3.3 Referenzdatei 05: Unabhängiges Referenzmuster nach Vorgaben des BVBS / GAEB DA XML 3.3 Standards -->
<GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA_XML_3.3">
  <GAEBInfo>
    <Version>3.3</Version>
    <Date>2026-09-28</Date>
    <Time>10:00:00</Time>
    <ProgMan>BVBS Standard GAEB DA XML 3.3 Referenzgenerator</ProgMan>
  </GAEBInfo>
  <Award>
    <DP>83</DP>
    <AwardInfo>
      <Cur>EUR</Cur>
    </AwardInfo>
    <BoQ ID="BOQ_BVBS_05">
      <BoQInfo>
        <Name>BVBS Standard-Referenzleistungsverzeichnis Verkehrswegebau</Name>
        <LblBoQ>Referenz-Ausschreibung BVBS / GAEB DA XML 3.3</LblBoQ>
        <CPN>BVBS-REF-2026-X83</CPN>
      </BoQInfo>
      <BoQBody>
        <!-- Ebene 1: Gewerk / Leistungsbereich 01 -->
        <BoQCtgy ID="CTG_01" RNoPart="01">
          <LblTx>
            <p><span>01 Entwässerungs- und Erdarbeiten</span></p>
          </LblTx>
          <BoQBody>
            <!-- Ebene 2: Titel / Abschnitt 01: Erdarbeiten -->
            <BoQCtgy ID="CTG_01_01" RNoPart="01">
              <LblTx>
                <p><span>Abschnitt 01: Erdarbeiten und Bodenabtrag</span></p>
              </LblTx>
              <BoQBody>
                <Itemlist>
                  <!-- Position 01.01.0010: m³ -->
                  <Item ID="POS_01_01_0010" RNoPart="0010">
                    <RNoPart>0010</RNoPart>
                    <OZ>01.01.0010</OZ>
                    <Qty>850.000</Qty>
                    <QU>m³</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Boden der Bodenklassen 3 bis 5 im Bereich der geplanten Trasse profilgerecht ausheben und seitlich lagern.</span></p>
                            <p><span>Abfuhr überschüssigen Materials auf eine geeignete Deponie nach Wahl des Auftragnehmers einschließlich aller Deponie- und Entsorgungsgebühren.</span></p>
                          </Text>
                        </DetailTxt>
                      </CompleteText>
                      <OutlineText>
                        <OutlTxt>
                          <TextOutl><span>Bodenaushub BK 3-5 Trassenbereich</span></TextOutl>
                        </OutlTxt>
                      </OutlineText>
                    </Description>
                  </Item>
                  <!-- Position 01.01.0020: m² -->
                  <Item ID="POS_01_01_0020" RNoPart="0020">
                    <RNoPart>0020</RNoPart>
                    <OZ>01.01.0020</OZ>
                    <Qty>2400.000</Qty>
                    <QU>m²</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Planum für Verkehrsflächen herstellen und verdichten nach ZTVE-StB.</span></p>
                            <p><span>Ebenheitstoleranzen nach DIN 18318 sind strikt einzuhalten. Nachweis des Verformungsmoduls Ev2 mittels statischem Plattendruckversuch.</span></p>
                          </Text>
                        </DetailTxt>
                      </CompleteText>
                      <OutlineText>
                        <OutlTxt>
                          <TextOutl><span>Planum herstellen und verdichten</span></TextOutl>
                        </OutlTxt>
                      </OutlineText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>

            <!-- Ebene 2: Titel / Abschnitt 02: Entwässerungskanäle -->
            <BoQCtgy ID="CTG_01_02" RNoPart="02">
              <LblTx>
                <p><span>Abschnitt 02: Entwässerungsleitungen und Schächte</span></p>
              </LblTx>
              <BoQBody>
                <Itemlist>
                  <!-- Position 01.02.0010: m -->
                  <Item ID="POS_01_02_0010" RNoPart="0010">
                    <RNoPart>0010</RNoPart>
                    <OZ>01.02.0010</OZ>
                    <Qty>160.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Kanalrohre aus Steinzeug DN 250 nach DIN EN 295 mit Steckmuffenverbindung liefern und fachgerecht im vorbereiteten Rohrgraben verlegen.</span></p>
                            <p><span>Inklusive Dichtheitsprüfung nach DIN EN 1610 mit Luftüberdruck.</span></p>
                          </Text>
                        </DetailTxt>
                      </CompleteText>
                      <OutlineText>
                        <OutlTxt>
                          <TextOutl><span>Steinzeug-Kanalrohr DN 250 verlegen</span></TextOutl>
                        </OutlTxt>
                      </OutlineText>
                    </Description>
                  </Item>
                  <!-- Position 01.02.0020: Stk -->
                  <Item ID="POS_01_02_0020" RNoPart="0020">
                    <RNoPart>0020</RNoPart>
                    <OZ>01.02.0020</OZ>
                    <Qty>4.000</Qty>
                    <QU>Stk</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Fertigteil-Betonschacht DN 1000 nach DIN 4034 Teil 1 bestehend aus Schachtunterteil mit werkseitig hergestelltem Gerinne, Schachtringen, Konus und Schachtabdeckung Klasse D 400.</span></p>
                          </Text>
                        </DetailTxt>
                      </CompleteText>
                      <OutlineText>
                        <OutlTxt>
                          <TextOutl><span>Beton-Revisionsschacht DN 1000 kpl.</span></TextOutl>
                        </OutlTxt>
                      </OutlineText>
                    </Description>
                  </Item>
                  <!-- Position 01.02.0030: Psch -->
                  <Item ID="POS_01_02_0030" RNoPart="0030">
                    <RNoPart>0030</RNoPart>
                    <OZ>01.02.0030</OZ>
                    <Qty>1.000</Qty>
                    <QU>Psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Kamerabefahrung (TV-Inspektion) aller neu verlegten Haltungen gemäß ATV-M 143 Teil 2 einschließlich digitaler Übergabe des Prüfprotokolls und Videoaufzeichnung.</span></p>
                          </Text>
                        </DetailTxt>
                      </CompleteText>
                      <OutlineText>
                        <OutlTxt>
                          <TextOutl><span>TV-Kamerainspektion Entwässerung</span></TextOutl>
                        </OutlTxt>
                      </OutlineText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
          </BoQBody>
        </BoQCtgy>
      </BoQBody>
    </BoQ>
  </Award>
</GAEB>
