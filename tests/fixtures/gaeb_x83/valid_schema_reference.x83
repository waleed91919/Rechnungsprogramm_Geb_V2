          <Length>4</Length>
          <Num>Yes</Num>
        </BoQBkdn>
      </BoQInfo>
      <BoQBody>
        <!-- Gewerk 01 -->
        <BoQCtgy ID="CTG_01" RNoPart="01">
          <LblTx>
            <p><span>01 Rohbauarbeiten</span></p>
          </LblTx>
          <BoQBody>
            <!-- Abschnitt 01 -->
            <BoQCtgy ID="CTG_01_01" RNoPart="01">
              <LblTx>
                <p><span>Abschnitt 01: Erdarbeiten</span></p>
              </LblTx>
              <BoQBody>
                <Itemlist>
                  <!-- Position 01.01.0010: Normalposition unbepreist -->
                  <Item ID="POS_01_01_0010" RNoPart="0010">
                    <Qty>350.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Mutterboden bis 20 cm Dicke im Baufeld abschieben und lagern.</span></p>
                            <p><span>Bodenklasse 3 nach DIN 18300.</span></p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p><span>Mutterboden abtragen d=20cm</span></p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <!-- Position 01.01.0020: Normalposition unbepreist -->
                  <Item ID="POS_01_01_0020" RNoPart="0020">
                    <Qty>420.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Baugrubenaushub Bodenklasse 3 bis 4 für Fundamente herstellen.</span></p>
                            <p><span>Aushubmaterial seitlich auf der Baustelle profilgerecht lagern.</span></p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p><span>Baugrubenaushub BK 3-4</span></p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <!-- Abschnitt 02 -->
            <BoQCtgy ID="CTG_01_02" RNoPart="02">
              <LblTx>
                <p><span>Abschnitt 02: Entwässerung</span></p>
              </LblTx>
              <BoQBody>
                <Itemlist>
                  <!-- Position 01.02.0010 -->
                  <Item ID="POS_01_02_0010" RNoPart="0010">
                    <Qty>85.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p><span>Grundleitungen DN 150 aus PVC-U nach DIN EN 1401 verlegen.</span></p>
                            <p><span>Einschließlich Sandbettung 10 cm und Verfüllen der Leitungszone.</span></p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p><span>Grundleitungen PVC DN 150 verlegen</span></p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
          </BoQBody>
